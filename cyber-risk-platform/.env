# ==============================================================================
# CyberRisk-Guidewire-Connector (CRGC) Environment Configuration
# ==============================================================================

# Application Runtime Configuration
APP_NAME="CyberRisk-Guidewire-Connector"
APP_ENV="development"                  # development | staging | production
DEBUG=true
HOST="0.0.0.0"
PORT=8000
LOG_LEVEL="INFO"                       # DEBUG | INFO | WARNING | ERROR

# Guidewire PolicyCenter 10.2.1 Cloud Integration
# When GW_MOCK_MODE=true, realistic simulated responses are returned without a live instance
GW_MOCK_MODE=true
GW_BASE_URL="https://pc-eval-cloud.guidewire.net/pc"
GW_POLICYCENTER_VERSION="10.2.1"
GW_AUTH_TYPE="oauth2"                  # oauth2 | basic
GW_AUTH_URL="https://pc-eval-cloud.guidewire.net/oauth2/token"
GW_CLIENT_ID="crgc_edge_service_client_id"
GW_CLIENT_SECRET="crgc_edge_service_client_secret"
GW_USERNAME="su"
GW_PASSWORD="gw"
GW_TIMEOUT_SECONDS=15.0

# Guidewire Cloud REST API Endpoints (PolicyCenter 10.2.1)
GW_ACTIVITIES_PATH="/rest/common/v1/activities"
GW_POLICY_NOTES_PATH="/rest/policy/v1/policies/{policyNumber}/notes"
GW_POLICIES_PATH="/rest/policy/v1/policies/{policyNumber}"

# Actuarial Risk Scoring Thresholds & Parameters
# Benchmark: Total Score is between 0.0 (Clean/Resilient) and 100.0 (Catastrophic Risk)
BASE_RISK_SCORE=5.0
RISK_SCORE_MONITOR_THRESHOLD=40.0
RISK_SCORE_REVIEW_THRESHOLD=60.0

# Factor Benchmark Thresholds
MFA_ENFORCEMENT_THRESHOLD=0.80         # Minimum 80% enforcement required
EDR_AGENT_COVERAGE_THRESHOLD=0.85      # Minimum 85% endpoint agent coverage required
CRITICAL_CVE_AGING_DAYS_THRESHOLD=14   # > 14 days aging triggers escalation penalty

# Factor Penalty Weights (Actuarially Calibrated)
PENALTY_MFA_MAX=30.0                   # Max penalty points for absent/low MFA
PENALTY_EXPOSED_RDP=25.0               # Immediate penalty for exposed remote desktop port (3389)
PENALTY_CRITICAL_CVE_PER_ITEM=12.5     # Points per critical unpatched CVE aging > 14 days
PENALTY_CRITICAL_CVE_MAX=35.0          # Cap on critical CVE aging penalties
PENALTY_EDR_MAX=20.0                   # Max penalty points for deficient EDR coverage
